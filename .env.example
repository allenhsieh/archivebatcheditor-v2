# Archive.org credentials (REQUIRED)
# Get from https://archive.org/account/s3.php
ARCHIVE_ACCESS_KEY=
ARCHIVE_SECRET_KEY=
ARCHIVE_EMAIL=

# YouTube API key (read access; needed for the initial channel cache fetch)
# Get from https://console.cloud.google.com/ (enable "YouTube Data API v3")
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# YouTube OAuth (REQUIRED for writing to your YouTube videos)
# Same Google Cloud project. Create OAuth client ID with redirect URI:
# http://localhost:3000/api/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# Database
DATABASE_PATH=./data/app.db

# Server
NODE_ENV=development
